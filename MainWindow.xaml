<Window x:Class="ProjectToPromptScanner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ProjectToPromptScanner"
        WindowState="Maximized"
        Activated="Window_Activated"
        Title="Code Project Scanner to Prompt" Height="750" Width="900">

    <Window.Resources>
        <local:InverseBoolConverter x:Key="InverseBoolConverter"/>
        <local:TreeDepthConverter x:Key="TreeDepthConverter"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- SECTION 1: QUICK SAVE/LOAD (TOOLBAR) -->
        <Border Grid.Row="0" Background="#F0F0F0" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" Padding="10,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="30"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="80"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Save Name:" VerticalAlignment="Center" Margin="0,0,5,0" FontWeight="SemiBold"/>
                <TextBox x:Name="txtSaveName" Grid.Column="1" Margin="0,0,5,0" Padding="3" VerticalContentAlignment="Center"/>
                <Button Content="Save" Grid.Column="2" Click="BtnQuickSave_Click" Cursor="Hand"/>

                <TextBlock Text="Load Config:" VerticalAlignment="Center" Margin="0,0,5,0" Grid.Column="4" FontWeight="SemiBold"/>
                <ComboBox x:Name="cboSavedConfigs" Grid.Column="5" Margin="0,0,5,0" VerticalContentAlignment="Center" SelectionChanged="cboSavedConfigs_SelectionChanged"/>
                <Button Content="Load" Grid.Column="6" Click="BtnQuickLoad_Click" Cursor="Hand" Margin="0,0,5,0"/>
                <Button Content="New" Grid.Column="7" Click="BtnNew_Click" Cursor="Hand"/>
            </Grid>
        </Border>

        <!-- SECTION 2: FILTERS EXPANDER -->
        <Expander Grid.Row="1" IsExpanded="False" Margin="10,10,10,5">
            <Expander.Header>
                <TextBlock Text="Cấu hình bộ lọc nâng cao (Filter Settings)" FontWeight="Bold" Foreground="#333333"/>
            </Expander.Header>
            <Border BorderBrush="#DDDDDD" BorderThickness="1" Padding="10" Background="#FAFAFA" Margin="0,5,0,0" CornerRadius="3">
                <StackPanel>
                    <TextBlock Text="Cấu hình lọc File:" FontWeight="Bold" Margin="0,0,0,5"/>
                    <Grid Margin="0,0,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <RadioButton x:Name="rbIgnore" GroupName="FilterMode" IsChecked="True" VerticalAlignment="Center" Content="Ignore Mode (Bỏ qua các đuôi sau):"/>
                        <TextBox x:Name="txtExtensionIgnore" Grid.Column="1" Padding="5" IsEnabled="{Binding ElementName=rbIgnore, Path=IsChecked}" Text=".exe;.dll;.pdb;.cache;.suo;.user;.png;.jpg;.jpeg;.ico;.obj" KeyDown="FilterTextBox_KeyDown"/>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <RadioButton x:Name="rbOnly" GroupName="FilterMode" VerticalAlignment="Center" Content="Only Mode (Chỉ lấy các đuôi sau):"/>
                        <TextBox x:Name="txtExtensionOnly" Grid.Column="1" Padding="5" IsEnabled="{Binding ElementName=rbOnly, Path=IsChecked}" Text=".cs;.xaml;.xml;.json;.js;.ts;.html;.css;.sql" KeyDown="FilterTextBox_KeyDown"/>
                    </Grid>

                    <TextBlock Text="Folder Names Ignore (.git;bin;obj...):" FontWeight="Bold" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtFolderIgnore" Text=".git;bin;obj;.vs;node_modules;debug;release" Padding="5" Margin="0,0,0,5" KeyDown="FilterTextBox_KeyDown"/>

                    <TextBlock Text="File Names Ignore:" FontWeight="Bold" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtFileIgnore" Text="" Padding="5" KeyDown="FilterTextBox_KeyDown"/>
                </StackPanel>
            </Border>
        </Expander>

        <!-- SECTION 3: PROJECT PATH -->
        <StackPanel Grid.Row="2" Margin="10,5,10,10">
            <Grid Margin="0,0,0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="txtFolderPath" Padding="8,5" Text="Chọn đường dẫn dự án..." VerticalContentAlignment="Center" IsReadOnly="True" Background="#F9F9F9"/>
                <Button Content="..." Width="50" Grid.Column="1" Click="BtnBrowse_Click" Margin="5,0,0,0" FontWeight="Bold"/>
            </Grid>
            <StackPanel Orientation="Horizontal" Margin="2,0,0,0">
                <TextBlock x:Name="txtCheckedCount" Text="Số file đã chọn: C1 (0) | C2 (0) | C3 (0)" FontWeight="Bold" Foreground="#005A9E" VerticalAlignment="Center"/>
                <Button Content="Reset" Click="BtnReset_Click" Margin="10,0,0,0" Padding="8,2" FontWeight="SemiBold" Cursor="Hand"/>
            </StackPanel>
        </StackPanel>

        <!-- SECTION 4: MAIN AREA -->
        <Grid Grid.Row="3" Margin="10,0,10,10" Grid.IsSharedSizeScope="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.5*" MinWidth="600"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*" MinWidth="150"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TabControl x:Name="tabMain" Grid.Row="0" Grid.Column="0" Grid.RowSpan="2" Margin="0,0,0,0">
                <TabItem Header="Files Tree">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Grid.Column="0" Background="#E1E1E1" BorderBrush="#CCCCCC" BorderThickness="1,1,1,0">
                            <Grid Margin="0,0,18,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="300" MinWidth="150" SharedSizeGroup="NameCol"/>
                                    <ColumnDefinition Width="5"/>
                                    <ColumnDefinition Width="65"/>
                                    <ColumnDefinition Width="65"/>
                                    <ColumnDefinition Width="65"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="File / Folder Name" FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#B0B0B0" Cursor="SizeWE" Margin="2,0,2,0"/>
                                <CheckBox Grid.Column="2" Tag="0" Content="Check 1" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Click="ChkToggleAll_Click" ToolTip="Toggle All Check 1"/>
                                <CheckBox Grid.Column="3" Tag="1" Content="Check 2" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Click="ChkToggleAll_Click" ToolTip="Toggle All Check 2"/>
                                <CheckBox Grid.Column="4" Tag="2" Content="Check 3" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Click="ChkToggleAll_Click" ToolTip="Toggle All Check 3"/>
                            </Grid>
                        </Border>

                        <TreeView x:Name="tvFolder" Grid.Row="1" Grid.Column="0" BorderBrush="#CCCCCC" BorderThickness="1" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                            <TreeView.ItemContainerStyle>
                                <Style TargetType="TreeViewItem">
                                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="TreeViewItem">
                                                <StackPanel>
                                                    <Border Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                                        <ContentPresenter x:Name="PART_Header" ContentSource="Header" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                                                    </Border>
                                                    <ItemsPresenter x:Name="ItemsHost" Visibility="Collapsed"/>
                                                </StackPanel>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsExpanded" Value="True">
                                                        <Setter TargetName="ItemsHost" Property="Visibility" Value="Visible"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#CCE8FF"/>
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#E5F3FF"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </TreeView.ItemContainerStyle>

                            <TreeView.ItemTemplate>
                                <HierarchicalDataTemplate DataType="{x:Type local:FileTreeItem}" ItemsSource="{Binding Children}">
                                    <Grid Background="Transparent" Margin="0,3">
                                        <Grid.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Copy Name" Click="CtxCopyName_Click"/>
                                                <MenuItem Header="Show Explorer" Click="CtxShowExplorer_Click"/>
                                                <MenuItem Header="Show with VSCode" Click="CtxShowVSCode_Click"/>
                                                <Separator />
                                                <MenuItem Header="Exclude" Click="CtxExclude_Click"/>
                                                <MenuItem Header="Exclude Extension" Click="CtxExcludeExtension_Click"/>
                                            </ContextMenu>
                                        </Grid.ContextMenu>

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100" SharedSizeGroup="NameCol"/>
                                            <ColumnDefinition Width="5"/>
                                            <ColumnDefinition Width="65"/>
                                            <ColumnDefinition Width="65"/>
                                            <ColumnDefinition Width="65"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="5,0,0,0">
                                            <Border Width="{Binding RelativeSource={RelativeSource AncestorType=TreeViewItem}, Converter={StaticResource TreeDepthConverter}}"/>
                                            <ToggleButton x:Name="Expander" ClickMode="Press" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType=TreeViewItem}}">
                                                <ToggleButton.Style>
                                                    <Style TargetType="ToggleButton">
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="ToggleButton">
                                                                    <Border Width="16" Height="16" Background="Transparent" Margin="2,0,2,0">
                                                                        <Path x:Name="ExpandPath" Data="M 4 4 L 8 8 L 4 12" Stroke="#555" StrokeThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsChecked" Value="True">
                                                                            <Setter TargetName="ExpandPath" Property="Data" Value="M 4 4 L 8 8 L 12 4"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Children.Count}" Value="0">
                                                                <Setter Property="Visibility" Value="Hidden"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ToggleButton.Style>
                                            </ToggleButton>
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="2,0,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsIgnored}" Value="True">
                                                                <Setter Property="Foreground" Value="Gray"/>
                                                                <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>

                                        <CheckBox Grid.Column="2" IsChecked="{Binding IsChecked, Mode=TwoWay}" IsThreeState="{Binding IsFile, Converter={StaticResource InverseBoolConverter}}" HorizontalAlignment="Center" VerticalAlignment="Center" IsEnabled="{Binding IsIgnored, Converter={StaticResource InverseBoolConverter}}"/>
                                        <CheckBox Grid.Column="3" IsChecked="{Binding IsChecked2, Mode=TwoWay}" IsThreeState="{Binding IsFile, Converter={StaticResource InverseBoolConverter}}" HorizontalAlignment="Center" VerticalAlignment="Center" IsEnabled="{Binding IsIgnored, Converter={StaticResource InverseBoolConverter}}"/>
                                        <CheckBox Grid.Column="4" IsChecked="{Binding IsChecked3, Mode=TwoWay}" IsThreeState="{Binding IsFile, Converter={StaticResource InverseBoolConverter}}" HorizontalAlignment="Center" VerticalAlignment="Center" IsEnabled="{Binding IsIgnored, Converter={StaticResource InverseBoolConverter}}"/>
                                    </Grid>
                                </HierarchicalDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                    </Grid>
                </TabItem>
                <TabItem Header="Virtual Files">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Grid.Column="0" Background="#E1E1E1" BorderBrush="#CCCCCC" BorderThickness="1,1,1,0">
                            <Grid Margin="0,0,18,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="300" MinWidth="150" SharedSizeGroup="NameCol"/>
                                    <ColumnDefinition Width="5"/>
                                    <ColumnDefinition Width="65"/>
                                    <ColumnDefinition Width="65"/>
                                    <ColumnDefinition Width="65"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="File / Folder Name" FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#B0B0B0" Cursor="SizeWE" Margin="2,0,2,0"/>
                                <CheckBox Grid.Column="2" Tag="0" Content="Check 1" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Click="ChkToggleAll_Click" ToolTip="Toggle All Check 1"/>
                                <CheckBox Grid.Column="3" Tag="1" Content="Check 2" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Click="ChkToggleAll_Click" ToolTip="Toggle All Check 2"/>
                                <CheckBox Grid.Column="4" Tag="2" Content="Check 3" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Click="ChkToggleAll_Click" ToolTip="Toggle All Check 3"/>
                            </Grid>
                        </Border>

                        <TreeView x:Name="tvVirtualFolder" Grid.Row="1" Grid.Column="0" BorderBrush="#CCCCCC" BorderThickness="1" ScrollViewer.HorizontalScrollBarVisibility="Auto" ItemContainerStyle="{Binding ItemContainerStyle, ElementName=tvFolder}" ItemTemplate="{Binding ItemTemplate, ElementName=tvFolder}"/>
                    </Grid>
                </TabItem>                
            </TabControl>

            <GridSplitter Grid.Column="1" Grid.Row="0" Grid.RowSpan="2" Width="5" HorizontalAlignment="Stretch" Background="#E0E0E0" Cursor="SizeWE"/>

            <Border Grid.Column="2" Grid.Row="0" Grid.RowSpan="2" Margin="10,0,0,0" BorderBrush="#CCCCCC" BorderThickness="1" Background="#FAFAFA">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Checked Files" FontWeight="Bold" Margin="10,8" Foreground="#333"/>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="icCheckedFiles">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding Name}" ToolTip="{Binding FullPath}" Margin="5,2" Padding="8,4" Cursor="Hand" Click="BtnCheckedFile_Click" Tag="{Binding}">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsChecked}" Value="True">
                                                        <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsChecked2}" Value="True">
                                                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsChecked3}" Value="True">
                                                        <Setter Property="HorizontalContentAlignment" Value="Right"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Right Panel: Exported File -->
            <Border Grid.Column="3" Grid.Row="0" Grid.RowSpan="2" BorderBrush="#CCCCCC" BorderThickness="1" Background="#FAFAFA" Margin="10,0,0,0" Padding="10">
                <StackPanel VerticalAlignment="Top">
                    <TextBlock Text="Latest Export:" FontWeight="Bold" Margin="0,0,0,10" Foreground="#333"/>
                    <Border x:Name="btnLatestExport1" Height="40" Visibility="Collapsed" Cursor="Hand" ToolTip="Click to send or Drag file" Margin="0,0,0,5"
                            BorderBrush="#999999" BorderThickness="1" CornerRadius="3" Tag="0"
                            PreviewMouseLeftButtonDown="BtnLatestExport_PreviewMouseLeftButtonDown"
                            PreviewMouseMove="BtnLatestExport_MouseMove">
                        <Border.Resources>
                            <Storyboard x:Key="BlinkAnimation">
                                <ColorAnimation Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" From="#E1F0FA" To="#FFEB3B" Duration="0:0:0.3" AutoReverse="True" RepeatBehavior="3x" />
                            </Storyboard>
                        </Border.Resources>
                        <Border.Background>
                            <SolidColorBrush Color="#E1F0FA"/>
                        </Border.Background>
                        <TextBlock x:Name="txtLatestExportName1" TextTrimming="CharacterEllipsis" Padding="10,0" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>
                    <Border x:Name="btnLatestExport2" Height="40" Visibility="Collapsed" Cursor="Hand" ToolTip="Click to send or Drag file" Margin="0,0,0,5"
                            BorderBrush="#999999" BorderThickness="1" CornerRadius="3" Tag="1"
                            PreviewMouseLeftButtonDown="BtnLatestExport_PreviewMouseLeftButtonDown"
                            PreviewMouseMove="BtnLatestExport_MouseMove"
                            MouseLeftButtonUp="BtnLatestExport_MouseLeftButtonUp">
                        <Border.Resources>
                            <Storyboard x:Key="BlinkAnimation">
                                <ColorAnimation Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" From="#E1F0FA" To="#FFEB3B" Duration="0:0:0.3" AutoReverse="True" RepeatBehavior="3x" />
                            </Storyboard>
                        </Border.Resources>
                        <Border.Background>
                            <SolidColorBrush Color="#E1F0FA"/>
                        </Border.Background>
                        <TextBlock x:Name="txtLatestExportName2" TextTrimming="CharacterEllipsis" Padding="10,0" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>
                    <Border x:Name="btnLatestExport3" Height="40" Visibility="Collapsed" Cursor="Hand" ToolTip="Click to send or Drag file"
                            BorderBrush="#999999" BorderThickness="1" CornerRadius="3" Tag="2"
                            PreviewMouseLeftButtonDown="BtnLatestExport_PreviewMouseLeftButtonDown"
                            PreviewMouseMove="BtnLatestExport_MouseMove"
                            MouseLeftButtonUp="BtnLatestExport_MouseLeftButtonUp">
                        <Border.Resources>
                            <Storyboard x:Key="BlinkAnimation">
                                <ColorAnimation Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" From="#E1F0FA" To="#FFEB3B" Duration="0:0:0.3" AutoReverse="True" RepeatBehavior="3x" />
                            </Storyboard>
                        </Border.Resources>
                        <Border.Background>
                            <SolidColorBrush Color="#E1F0FA"/>
                        </Border.Background>
                        <TextBlock x:Name="txtLatestExportName3" TextTrimming="CharacterEllipsis" Padding="10,0" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

        <!-- SECTION 5: FOOTER BUTTONS -->
        <Grid Grid.Row="4" Margin="10,0,10,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Button Content="Export 1" Height="45" Click="BtnExport1_Click" FontWeight="Bold" Margin="0,0,10,0" Padding="25,0"/>
                <Button Content="Export 2" Height="45" Click="BtnExport2_Click" FontWeight="Bold" Margin="0,0,10,0" Padding="25,0"/>
                <Button Content="Export 3" Height="45" Click="BtnExport3_Click" FontWeight="Bold" Margin="0,0,10,0" Padding="25,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="test" Height="45" Click="Test_Click" Padding="20,0" Margin="0,0,10,0"/>
                <Button Content="Import from AI" Height="45" Click="BtnImport_Click" Padding="20,0" Margin="0,0,10,0"/>
                <Button Content="Open Folder" Height="45" Click="BtnOpenFolder_Click" Padding="15,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
